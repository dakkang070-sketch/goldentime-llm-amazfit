{
  "configVersion": "v3",
  "app": {
    "appId": 20002,
    "appName": "GOLDENLink",
    "appType": "app",
    "version": {
      "code": 85,
      "name": "1.6.75"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "GOLDENLink watch companion"
  },
  "permissions": [
    "device:os.bg_service",
    "data:user.hd.heart_rate",
    "data:user.hd.spo2",
    "data:user.hd.body_temp",
    "data:user.hd.step",
    "device:os.accelerometer",
    "device:os.gyroscope",
    "device:os.barometer",
    "device:os.geolocation",
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0.0",
      "target": "4.0.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
           "dw": 390
        },
        {
          "st": "b",
           "dw": 194
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "GOLDENLink"
    }
  },
  "defaultLanguage": "en-US"
}
