NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/goldentime

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Ollama (로컬)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Ollama 사용(있으면 true)
ENABLE_OLLAMA=false

# 파인튜닝된 모델 사용 (true로 설정 시 파인튜닝된 모델 사용)
USE_FINETUNED_MODEL=false
OLLAMA_FINETUNED_MODEL=goldentime-emergency:latest

# 완전 자동 학습 시스템 설정
ENABLE_AUTO_LEARNING=false
ENABLE_AUTO_DEPLOY=false

# 정교한 의료 가중치 시스템 설정
ENABLE_ADVANCED_WEIGHTING=false

# 완전한 응급 대응 워크플로우 자동화 시스템 설정
ENABLE_EMERGENCY_WORKFLOW=true

# 종합적인 피드백 및 품질 관리 시스템 설정
ENABLE_QUALITY_MANAGEMENT=true

# 실시간 생체신호 분석 엔진 설정
ENABLE_REALTIME_BIOSIGNAL=true

# 국립중앙의료원 API 설정 (실제 API 인증키 적용)
NEDC_API_BASE_URL=https://apis.data.go.kr/B552657
NEDC_API_SERVICE_KEY=f77c4cc08ca51e363f167702969f0f94f2b8c27cfe9eeeea365caea7dfd37670
ENABLE_HOSPITAL_MATCHING=true
ENABLE_NEDC_API=true

# 건강보험심사평가원 HIRA API 설정 (30분 캐시, 자동갱신)
HIRA_API_SERVICE_KEY=f77c4cc08ca51e363f167702969f0f94f2b8c27cfe9eeeea365caea7dfd37670

# 자동 갱신 주기 설정 (선택사항)
NEDC_REFRESH_INTERVAL_MINUTES=2
NEDC_DAILY_SYNC_HOUR=1

# 이메일 알림 설정 (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@goldentime.com

# SMS 알림 설정 (알리고 API - 선택사항)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_PHONE=

# OSRM 라우팅 서버 (기본값: 공개 OSRM 서버)
OSRM_BASE_URL=http://router.project-osrm.org

# 국립중앙의료원 전국 응급의료기관 정보 조회 서비스 API
EMERGENCY_HOSPITAL_API_URL=https://apis.data.go.kr/B552657/ErmctInfoInqireService
EMERGENCY_HOSPITAL_API_KEY=f77c4cc08ca51e363f167702969f0f94f2b8c27cfe9eeeea365caea7dfd37670
