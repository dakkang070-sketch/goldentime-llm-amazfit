{
  "name": "goldentime-llm",
  "version": "2.0.0",
  "description": "AI 응급관제시스템 with 물질 남용 탐지 (음주/마약/향정신성약물)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:dashboard": "cd frontend && PORT=8010 npm run dev",
    "serve:dashboard": "node scripts/amazfit/serve-dashboard-prod.js",
    "dev:mobile": "cd m_app/goldentime && npm run dev",
    "dev:guardian-mobile": "cd guardian_ama_app && npm run dev",
    "dev:welfare-mobile": "cd welfare_ama_app && npm run dev",
    "dev:admin": "cd backoffice_admin && PORT=8030 npm run dev",
    "dev:backend:emergency": "PORT=4003 nodemon backend/server.js",
    "dev:backend:crime": "PORT=7005 nodemon backend_crime/server.js",
    "dev:ui:amazfit": "concurrently \"npm run dev:dashboard\" \"npm run dev:mobile\" \"npm run dev:admin\"",
    "dev:amazfit": "concurrently \"npm run dev:backend:emergency\" \"npm run dev:backend:crime\" \"npm run dev:dashboard\" \"npm run dev:mobile\" \"npm run dev:admin\"",
    "build:dashboard": "cd frontend && npm run build",
    "build:mobile": "cd m_app/goldentime && npm run build",
    "build:guardian-mobile": "cd guardian_ama_app && npm run build",
    "build:welfare-mobile": "cd welfare_ama_app && npm run build",
    "build:admin": "cd backoffice_admin && npm run build",
    "preview:dashboard": "cd frontend && PORT=8010 npm run preview -- --port 8010 --strictPort",
    "preview:mobile": "cd m_app/goldentime && npm run preview -- --port 8050 --strictPort",
    "preview:guardian-mobile": "cd guardian_ama_app && npm run preview -- --port 8070 --strictPort",
    "preview:welfare-mobile": "cd welfare_ama_app && npm run preview",
    "preview:admin": "cd backoffice_admin && PORT=8030 npm run preview -- --port 8030 --strictPort",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint backend/**/*.js frontend/src/**/*.{js,jsx,ts,tsx}",
    "lint:fix": "eslint backend/**/*.js frontend/src/**/*.{js,jsx,ts,tsx} --fix",
    "setup:python": "cd backend && pip install -r requirements.txt",
    "train:transformers": "cd backend && python transformers/alcoholTransformer.py && python transformers/drugTransformer.py && python transformers/psychoactiveTransformer.py",
    "train:lora": "cd backend && python finetuning/loraFineTuning.py",
    "train:emergency-dataset": "node backend/scripts/rebuildEmergencyDataset.js && node backend/scripts/auditEmergencyDataset.js",
    "train:emergency-model": "bash scripts/fine-tune-model.sh",
    "train:emergency-full": "npm run train:emergency-dataset && npm run train:emergency-model && node backend/scripts/evaluateEmergencyOllama.js --limit 100 --timeout 60000 --concurrency 1",
    "process:data": "cd backend && python dataprocessing/substanceDataProcessor.py",
    "setup:complete": "npm install && npm run setup:python && npm run process:data && npm run train:transformers && npm run train:lora",
    "docker:build": "docker build -t goldentime-llm .",
    "docker:run": "docker run -p 3000:3000 -p 5173:5173 goldentime-llm",
    "backup": "node scripts/backup.js",
    "migrate": "node scripts/migrate.js",
    "seed:amazfit-demo": "node scripts/reset-amazfit-demo-data.js",
    "inspect:dataset": "node backend/scripts/inspect_dataset.js",
    "rebuild:emergency-dataset": "node backend/scripts/rebuildEmergencyDataset.js",
    "audit:emergency-dataset": "node backend/scripts/auditEmergencyDataset.js",
    "evaluate:emergency-ollama": "node backend/scripts/evaluateEmergencyOllama.js --limit 20",
    "evaluate:emergency-full-regression": "bash scripts/run-emergency-full-regression.sh",
    "extract:emergency-eval-mismatches": "node backend/scripts/extractEmergencyEvalMismatches.js",
    "train:violence": "python3 backend/finetuning/train_school_violence.py --mock",
    "train:violence:real": "python3 backend/finetuning/train_school_violence.py"
  },
  "keywords": [
    "emergency",
    "medical",
    "AI",
    "LLM",
    "substance-detection",
    "real-time",
    "healthcare",
    "monitoring",
    "transformer",
    "LoRA"
  ],
  "author": "Golden Time AI Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.10.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "fast-csv": "^4.3.6",
    "helmet": "^7.0.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.3.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "ollama": "^0.4.0",
    "puppeteer": "^21.1.1",
    "redis": "^4.6.7",
    "sharp": "^0.32.5",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.47.0",
    "@types/node": "^20.5.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goldentime-ai/goldentime-llm"
  },
  "bugs": {
    "url": "https://github.com/goldentime-ai/goldentime-llm/issues"
  },
  "homepage": "https://github.com/goldentime-ai/goldentime-llm#readme"
}
