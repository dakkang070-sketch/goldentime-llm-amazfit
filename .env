NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/goldentime

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Zepp 개발자 콘솔(앱 등록 후 발급)
ZEPP_CLIENT_ID=
ZEPP_CLIENT_SECRET=
ZEPP_REDIRECT_URI=http://localhost:3000/api/zepp/oauth/callback
ZEPP_API_BASE_URL=

# Ollama (로컬)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Ollama 사용(있으면 true)
ENABLE_OLLAMA=false

# 파인튜닝된 모델 사용 (true로 설정 시 파인튜닝된 모델 사용)
USE_FINETUNED_MODEL=false
OLLAMA_FINETUNED_MODEL=goldentime-emergency:latest

# 이메일 알림 설정 (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@goldentime.com

# SMS 알림 설정 (알리고 API - 선택사항)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_PHONE=

# OSRM 라우팅 서버 (기본값: 공개 OSRM 서버)
OSRM_BASE_URL=http://router.project-osrm.org

