# Golden Time LLM Environment Configuration
# 이 파일을 복사하여 .env로 이름을 변경하고 실제 값으로 수정하세요

# ====== 데이터베이스 설정 ======
MONGODB_URI=mongodb://localhost:27017/goldentime_llm
REDIS_URL=redis://localhost:6379

# ====== 서버 설정 ======
NODE_ENV=development
PORT=5000

# ====== Ollama LLM 설정 ======
OLLAMA_BASE_URL=http://localhost:11434
ENABLE_OLLAMA=true
USE_FINETUNED_MODEL=true
OLLAMA_FINETUNED_MODEL=goldentime-emergency:latest

# ====== API 키 설정 (실제 키로 변경 필요) ======
# 국립중앙의료원 API
NEDC_API_SERVICE_KEY=your_nedc_api_key_here

# 건강보험심사평가원 API  
HIRA_API_SERVICE_KEY=your_hira_api_key_here

# ====== JWT 보안 설정 ======
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ====== 기능 활성화 플래그 ======
ENABLE_AUTO_LEARNING=true
ENABLE_EMERGENCY_WORKFLOW=true
ENABLE_QUALITY_MANAGEMENT=true
ENABLE_REALTIME_BIOSIGNAL=true
ENABLE_SUBSTANCE_DETECTION=true

# ====== AI 모델 훈련 설정 ======
ENABLE_DATA_PROCESSING=false
ENABLE_MODEL_TRAINING=false
ENABLE_LORA_TRAINING=false

# ====== 로깅 설정 ======
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# ====== Rate Limiting 설정 ======
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# ====== WebSocket 설정 ======
WEBSOCKET_ENABLED=true
WEBSOCKET_CORS_ORIGIN=http://localhost:5173

# ====== AI 모델 경로 ======
AI_MODEL_PATH=./weights
LORA_MODEL_PATH=./lora_models
PROCESSED_DATA_PATH=./processed_data

# ====== 물질 탐지 시스템 설정 ======
# 음주 탐지 민감도 (low/medium/high)
ALCOHOL_DETECTION_SENSITIVITY=medium

# 마약 탐지 민감도 (conservative/standard/aggressive)  
DRUG_DETECTION_SENSITIVITY=standard

# 향정신성약물 탐지 민감도 (conservative/balanced/sensitive)
PSYCHOACTIVE_DETECTION_SENSITIVITY=balanced

# ====== 실시간 모니터링 설정 ======
MONITORING_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=5
MAX_CONCURRENT_ANALYSES=10

# ====== 병원 매칭 시스템 ======
HOSPITAL_MATCHING_RADIUS_KM=20
HOSPITAL_API_REFRESH_MINUTES=30
HOSPITAL_CACHE_TTL_MINUTES=60

# ====== 알림 설정 ======
# 이메일 (선택사항)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_FROM_EMAIL=goldentime@hospital.com

# SMS (선택사항)
SMS_API_KEY=your_sms_api_key
SMS_ENABLED=false

# ====== 개발 환경 설정 ======
# Swagger API 문서 활성화 (development only)
ENABLE_API_DOCS=true

# 디버그 모드
DEBUG=goldentime:*
VERBOSE_LOGGING=false

# ====== 성능 최적화 ======
# 캐시 설정
CACHE_TTL_SECONDS=300
ENABLE_REDIS_CACHE=true

# 워커 프로세스 수 (PM2 사용시)
WORKER_PROCESSES=1

# 메모리 제한 (MB)
MAX_MEMORY_MB=2048

# ====== 보안 설정 ======
# CORS 설정
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# 헬멧 보안 헤더
HELMET_ENABLED=true

# ====== 백업 설정 ======
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ====== GPU 설정 (AI 훈련용) ======
CUDA_VISIBLE_DEVICES=0
USE_GPU=false
GPU_MEMORY_LIMIT=8192

# ====== 실험적 기능 ======
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_BETA_UI=false